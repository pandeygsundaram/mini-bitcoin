# Vercel build-time configuration (public). Optional; can also be set in the UI.
MINI_DISCOVERY_URL=https://your-signaling-service.example
MINI_ICE_SERVERS=[]

# Signaling service runtime configuration. Keep TURN_SECRET on this service only.
PORT=8787
ALLOWED_ORIGINS=http://localhost:8080,https://your-app.vercel.app
STUN_URLS=stun:your-stun-host:3478
TURN_URLS=turn:your-turn-host:3478?transport=udp,turns:your-turn-host:5349?transport=tcp
TURN_SECRET=replace-with-your-coturn-static-auth-secret
MAX_PEERS=500
